# Postgres (SQLAlchemy + psycopg3 URL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/startng

# JWT signing secret: generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Google OAuth Web client ID (the same one used by the frontend)
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 games bucket (S3 API). Create an R2 API token scoped to the bucket (Object Read & Write).
# Account ID: Cloudflare dashboard > R2 overview. Never commit the real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=startng-games
# Games are served by the Worker at https://<name>.<GAMES_BASE_DOMAIN>
GAMES_BASE_DOMAIN=start.ng
# Must match RESERVED_NAMES on the Worker
RESERVED_GAME_NAMES=api,auth,login,www,3rdmainland
# Local testing only: with no R2 keys, POST /games/publish writes games to this folder instead
# (serve it with the Worker's dev-server.js). Leave empty on the server.
LOCAL_GAMES_DIR=
# The start.ng website, for links the API hands out (approving a game published without signing in)
SITE_URL=https://start.ng
# Keeping games up to date: the server checks each game's GitHub branch for new commits and
# republishes it when it changes. A GitHub token (fine-grained, public repos read-only, no other
# permissions) lifts GitHub's limit from 60 checks an hour to 5,000. Optional but recommended.
AUTO_UPDATE=true
GITHUB_TOKEN=
# Admin page (start.ng/admin): super admins, comma-separated. They have every permission and add the other
# admins by email. Admins sign in with Google as that email; there's no admin sign-up.
SUPER_ADMIN_EMAILS=
# Email (H1, FEATURES needs "email"). EMAIL_PROVIDER=log writes emails to the server log; brevo or smtp sends them.
# Get BREVO_API_KEY in Brevo: SMTP & API > API keys. EMAIL_FROM must be a sender Brevo has verified.
# For SMTP, use the host/port/security values from your mail host. Port 587 normally uses STARTTLS (SMTP_STARTTLS=true,
# SMTP_SSL=false); port 465 normally uses SSL (SMTP_STARTTLS=false, SMTP_SSL=true). Put SMTP_PASSWORD only in the server's
# environment (Coolify), never in the repo.
# While EMAIL_ONLY_TO is set, only those addresses get email (testing before go-live).
EMAIL_PROVIDER=log
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=start.ng <hello@mail.start.ng>
EMAIL_REPLY_TO=
EMAIL_ONLY_TO=
# A long random string; Brevo's webhook URL is <API_URL>/email/webhooks/brevo?key=<this> (bounces, spam complaints).
BREVO_WEBHOOK_KEY=
# Game health (H2, FEATURES needs "game_health"): also open each game's address, not just check its files.
# Set false on a laptop where the games' addresses aren't running.
GAME_HEALTH_HTTP=true
# F1 start.ng GitHub App (FEATURES needs "github_app"): GitHub signs each push with this secret, and the game updates
# straight away. The slug is the app's short name (github.com/apps/<slug>), for the "install it" link.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

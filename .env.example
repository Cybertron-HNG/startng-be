# Postgres (SQLAlchemy + psycopg3 URL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/startng

# JWT signing secret: generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Google OAuth Web client ID (the same one used by the frontend)
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 games bucket (S3 API). Create an R2 API token scoped to the bucket (Object Read & Write).
# Account ID: Cloudflare dashboard > R2 overview. Never commit the real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=startng-games
# Games are served by the Worker at https://<name>.<GAMES_BASE_DOMAIN>
GAMES_BASE_DOMAIN=start.ng
# Must match RESERVED_NAMES on the Worker
RESERVED_GAME_NAMES=api,auth,login,www,3rdmainland
# Local testing only: with no R2 keys, POST /games/publish writes games to this folder instead
# (serve it with the Worker's dev-server.js). Leave empty on the server.
LOCAL_GAMES_DIR=
# The start.ng website, for links the API hands out (approving a game published without signing in)
SITE_URL=https://start.ng
# Keeping games up to date: the server checks each game's GitHub branch for new commits and
# republishes it when it changes. A GitHub token (fine-grained, public repos read-only, no other
# permissions) lifts GitHub's limit from 60 checks an hour to 5,000. Optional but recommended.
AUTO_UPDATE=true
GITHUB_TOKEN=

# Explore games: games other people host on their own sites, listed on start.ng. Anyone can submit one
# without signing in. New games show at once; set EXPLORE_AUTO_APPROVE=false to hide them until a moderator
# approves them. EXPLORE_ADMIN_TOKEN lets a moderator remove or approve listings (header X-Admin-Token);
# leave it empty for none. Never commit a real value.
EXPLORE_AUTO_APPROVE=true
EXPLORE_PER_HOUR=5
EXPLORE_TOTAL_PER_HOUR=60
EXPLORE_ADMIN_TOKEN=
